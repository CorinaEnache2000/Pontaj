@using Pontaj.Models.Admin.Employees
@model EmployeesViewModel
@{
    ViewData["Title"] = "Angajați";
    ViewData["FullWidth"] = true;
}

<style>
    .full-height {
        height: 80vh;
    }

    .sidebar {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    #employeeList {
        flex-grow: 1;
        overflow-y: auto;
        min-height: 0;
    }

    .employee-item {
        cursor: pointer;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .spin {
        display: inline-block;
        animation: spin 0.8s linear infinite;
    }

    #employeeDetailsContent table {
        width: 100%;
        font-size: 0.75rem;
    }

    #employeeDetailsContent table th,
    #employeeDetailsContent table td {
        padding-left: 0.4rem;
        padding-right: 0.4rem;
    }
</style>

<div class="container-fluid full-height">
    <div class="row full-height">
        <div class="col-md-4 bg-light border-end sidebar p-2">
            <div class="d-flex align-items-center mb-2 gap-1">
                <input type="text"
                       class="form-control form-control-sm"
                       id="employeeSearch"
                       placeholder="Introduceți numele" />
                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="syncEmployees"
                        title="Sincronizează angajații">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            </div>

            @await Html.PartialAsync("Lists/_EmployeesList", Model.Employees)
        </div>

        <div class="col-md-8 p-3 overflow-auto" id="workArea">
            <div id="employeeDetails" class="d-none">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 id="selectedEmployeeName" class="mb-0"></h4>
                    <button type="button"
                            class="btn btn-sm"
                            id="employeeToggleActiveButton"
                            title="Activează / dezactivează angajatul">
                        <span id="employeeToggleActiveLabel"></span>
                    </button>
                </div>
                <div id="employeeDetailsContent"></div>
            </div>

            <div id="workAreaPlaceholder" class="text-muted fst-italic">
                Selectați un angajat din listă pentru a vedea detaliile.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/employees.js" asp-append-version="true"></script>
}
