@using Pontaj.Models.Admin.WorkStations
@model WorkStationDetail

@if (Model != null)
{
    <div class="mt-2">
        <table class="table table-sm table-hover align-middle text-center">
            <thead class="table-light text-center text-nowrap">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Nume</th>
                    <th scope="col">IP</th>
                    <th scope="col">ID unitate</th>
                    <th scope="col">Unitate organizațională</th>
                    <th scope="col">Activ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.Id</td>
                    <td>@Model.Name</td>
                    <td>@(string.IsNullOrWhiteSpace(Model.Ip) ? "—" : Model.Ip)</td>
                    <td>@Model.OrganizationalUnitId</td>
                    <td>@Model.OrganizationalUnitName</td>
                    <td class="active-cell" style="@(Model.Active ? "color: green; font-weight: bold;" : "color: red; font-weight: bold;")">
                        @(Model.Active ? "DA" : "NU")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
